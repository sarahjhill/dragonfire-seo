# Copy this file to .env and fill in what you need. Never commit .env.

# Django
DJANGO_SECRET_KEY=change-me-to-something-long-and-random
DJANGO_DEBUG=1

# Your name on every report (white-label it per client if you like)
DRAGONFIRE_AGENCY=Sarah J Hill
DRAGONFIRE_AGENCY_URL=https://sarahjhill.com

# Let the web form audit folders on this computer (keep 0 if you ever deploy this publicly)
DRAGONFIRE_ALLOW_FOLDERS=1

# --- Optional: "Does AI recommend you?" check -----------------------------
# Add any you have. Each one you add becomes a column in the report.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
PERPLEXITY_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
# ANTHROPIC_MODEL=claude-haiku-5-5
# PERPLEXITY_MODEL=sonar

# --- Free check / lead magnet ---------------------------------------------
# Who gets the "new lead" email
DRAGONFIRE_LEAD_ALERT_TO=sarah@sarahjhill.com
# Where the "Want it fixed?" button goes
DRAGONFIRE_BOOKING_URL=https://sarahjhill.com/project-os/forms/intake.html
# Set to 1 ONLY on the live server: locks everything except /free-check/ behind your admin login
DRAGONFIRE_PUBLIC=0
DRAGONFIRE_FREE_CHECKS_PER_HOUR=5
DRAGONFIRE_PUBLIC_MAX_PAGES=12
DRAGONFIRE_PUBLIC_AI=0

# Email sending for lead alerts (leave blank and alerts print in the terminal)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
